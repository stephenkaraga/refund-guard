# LiteLLM reads provider keys from the environment. Set the ones you use.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# For Bedrock models (e.g. bedrock/anthropic.claude-...):
# AWS_PROFILE=
# AWS_REGION_NAME=us-east-1

# Local models via Ollama need no key; use --llm ollama_chat/<model>.

# Set by `make tau2-data` (tau2's data folder for the user simulator).
# TAU2_DATA_DIR=/absolute/path/to/merchant-ops-agent/.tau2-bench/data
